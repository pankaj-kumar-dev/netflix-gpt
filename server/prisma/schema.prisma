generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  FREE
  PRO
}

model User {
  id                 String           @id @default(cuid())
  firebaseUid        String           @unique
  email              String           @unique
  displayName        String?
  photoURL           String?
  subscriptionTier   SubscriptionTier @default(FREE)
  stripeCustomerId   String?          @unique
  subscriptionEndsAt DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  searches           SearchHistory[]
  watchHistory       WatchHistory[]
}

model SearchHistory {
  id         String   @id @default(cuid())
  userId     String
  query      String
  movieNames String[]
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model WatchHistory {
  id         String   @id @default(cuid())
  userId     String
  movieId    Int
  title      String
  posterPath String?
  watchedAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
}

// Stores OpenAI text-embedding-3-small vectors (1536 dims) as JSON float[]
// Phase 5+ upgrade: Unsupported("vector(1536)") with pgvector for DB-side similarity
model MovieEmbedding {
  id        String   @id @default(cuid())
  movieId   Int      @unique
  title     String
  overview  String?
  genres    String[]
  embedding Json
  createdAt DateTime @default(now())

  @@index([movieId])
}
